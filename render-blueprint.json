{
  "version": "1",
  "services": [
    {
      "name": "aic-backend",
      "type": "web",
      "env": "python",
      "region": "frankfurt",
      "plan": "free",
      "buildCommand": "pip install -r requirements.txt",
      "startCommand": "cd backend && uvicorn main:app --host 0.0.0.0 --port $PORT",
      "envVars": {
        "DEEPSEEK_API_KEY": {
          "sync": false
        },
        "FRONTEND_URL": "https://jfsagro-glitch.github.io/AIC"
      },
      "healthCheckPath": "/health"
    }
  ],
  "databases": [
    {
      "name": "aic-db",
      "plan": "free",
      "databaseName": "aic"
    }
  ]
}

